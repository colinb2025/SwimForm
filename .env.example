# Copy to .env and fill in. Never commit .env. docs/SETUP.md explains each one.

# The public address people use, no trailing slash. Used in emailed links and the Google redirect.
SWIMFORM_BASE_URL=http://localhost:8000
# 1 when served over HTTPS (production). 0 for plain http://localhost.
SWIMFORM_SECURE_COOKIES=0

# Google sign-in (leave blank to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: console (prints to the log), smtp, or ses
SWIMFORM_EMAIL=console
SWIMFORM_EMAIL_FROM=SwimForm <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# For ses: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (or an instance role)

# Pose model:
#   synthetic  demo data from a simulated swimmer (for trying the site out)
#   collect    beta wave 0: store uploaded clips and wait; reports come when the model does
#   yolo       real analysis with the trained weights in SWIMFORM_WEIGHTS
SWIMFORM_POSE=collect
SWIMFORM_WEIGHTS=
SWIMFORM_WORKERS=1

# ---- Beta ----
# Your email(s), comma-separated: these accounts get /admin.
SWIMFORM_ADMINS=
# open | invite (codes from /admin/invites, everyone else joins the waitlist) | closed
SWIMFORM_SIGNUP=invite
# 1 = hold each finished report until you release it from /admin (optionally with a note)
SWIMFORM_REVIEW=1
# Shown on the Terms and Privacy pages.
SWIMFORM_COMPANY=SwimForm
SWIMFORM_CONTACT_EMAIL=
SWIMFORM_GOVERNING_LAW=the Commonwealth of Virginia, USA

# ---- Plans and payments (leave blank: everything free and unlimited) ----
# Analyses a free account can run per month. Blank = no limit.
SWIMFORM_FREE_ANALYSES=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# What the upgrade page says the price is, e.g. "$12 a month"
SWIMFORM_PRICE_LABEL=

# ---- Clip storage: local (this server's disk) or s3 (S3, Cloudflare R2, Backblaze B2) ----
SWIMFORM_STORAGE=local
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---- Error reports (optional) ----
SENTRY_DSN=

# Postgres password for docker-compose
POSTGRES_PASSWORD=change-me
